{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user's profile information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity, matching the Firebase Auth UID."
        },
        "username": {
          "type": "string",
          "description": "A unique username for the user."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating the last time the user account details were updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Represents a video meeting session.",
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string",
          "description": "The UID of the user who created the meeting."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the meeting was created."
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "finished"
          ],
          "description": "The current status of the meeting."
        }
      },
      "required": [
        "hostId",
        "createdAt",
        "status"
      ]
    },
    "Participant": {
      "title": "Participant",
      "description": "Represents a participant in a meeting.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The display name of the participant."
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the participant joined."
        }
      },
      "required": [
        "name",
        "joinedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "User profile document storing public information. The document ID (`userId`) MUST correspond to the Firebase Authentication UID."
        }
      },
      {
        "path": "/meetings/{meetingId}",
        "definition": {
          "entityName": "Meeting",
          "schema": {
            "$ref": "#/backend/entities/Meeting"
          },
          "description": "Stores information about a video meeting session."
        }
      },
      {
        "path": "/meetings/{meetingId}/participants/{participantId}",
        "definition": {
          "entityName": "Participant",
          "schema": {
            "$ref": "#/backend/entities/Participant"
          },
          "description": "A sub-collection representing participants in a meeting. The participantId should be the user's UID."
        }
      }
    ]
  }
}
