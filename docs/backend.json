
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user's profile information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity, matching the Firebase Auth UID."
        },
        "username": {
          "type": "string",
          "description": "A unique username for the user."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp indicating the last time the user account details were updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Represents a video meeting session.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name or title of the meeting."
        },
        "hostId": {
          "type": "string",
          "description": "The UID of the user who created the meeting."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the meeting was created."
        },
        "scheduledAt": {
          "type": "string",
          "format": "date-time",
          "description": "The scheduled start time for the meeting."
        },
        "endedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp indicating when the meeting was ended."
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "pending",
            "active",
            "finished"
          ],
          "description": "The current status of the meeting."
        },
        "seriesId": {
          "type": "string",
          "description": "ID of the recurring series this meeting belongs to."
        },
        "fixedDurationHours": {
          "type": "number",
          "description": "Fixed duration in hours for this session."
        },
        "sessionIndex": {
          "type": "integer",
          "description": "The index of this session in a series (e.g., Session 1 of 10)."
        },
        "totalSessionsInSeries": {
          "type": "integer",
          "description": "Total number of sessions expected in this series."
        },
        "isLocked": {
          "type": "boolean",
          "description": "Indicates if the meeting is locked."
        },
        "isRecording": {
          "type": "boolean",
          "description": "Indicates if the meeting is currently being recorded."
        },
        "screenSharerId": {
          "type": "string",
          "description": "UID of the participant currently sharing their screen."
        },
        "participantPermissions": {
          "type": "object",
          "properties": {
            "allowShareScreen": { "type": "boolean" },
            "allowSendReactions": { "type": "boolean" },
            "allowUnmute": { "type": "boolean" },
            "allowStartVideo": { "type": "boolean" }
          }
        }
      },
      "required": [
        "hostId",
        "createdAt",
        "status"
      ]
    },
    "SeriesAttendance": {
      "title": "SeriesAttendance",
      "description": "Tracks a user's cumulative attendance in a specific recurring series.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "seriesId": { "type": "string" },
        "attendedHours": { "type": "number" },
        "sessionsAttended": { "type": "integer" },
        "completedSessionIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "seriesId", "attendedHours", "sessionsAttended"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profile document."
        }
      },
      {
        "path": "/meetings/{meetingId}",
        "definition": {
          "entityName": "Meeting",
          "schema": { "$ref": "#/backend/entities/Meeting" },
          "description": "Meeting session document."
        }
      },
      {
        "path": "/seriesAttendance/{seriesId}/users/{userId}",
        "definition": {
          "entityName": "SeriesAttendance",
          "schema": { "$ref": "#/backend/entities/SeriesAttendance" },
          "description": "Cumulative attendance record for a user in a series."
        }
      }
    ]
  }
}
