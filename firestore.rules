
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isHost(meetingId) {
      return get(/databases/$(database)/documents/meetings/$(meetingId)).data.hostId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /meetings/{meetingId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        isHost(meetingId) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['screenSharerId', 'participantPermissions', 'status', 'endedAt']))
      );
      allow delete: if isSignedIn() && isHost(meetingId);
      
      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (request.auth.uid == participantId || isHost(meetingId));
      }

      match /chat/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      match /webrtc/{channelId} {
        allow read, write: if isSignedIn();
      }

      match /reactions/{reactionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      match /captions/{userId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /seriesAttendance/{recordId} {
      // Split read and write for clarity and ensure query optimization.
      // hostId must match for both single document gets and collection queries.
      allow read: if isSignedIn() && resource.data.hostId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.hostId == request.auth.uid;
    }
  }
}
