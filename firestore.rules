
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Standardized rules for meetings and their sub-collections
    // Using {document=**} to ensure 'list' operations (collection queries) are permitted
    match /meetings/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /seriesAttendance/{seriesId}/users/{userId} {
      allow read, write: if isSignedIn();
    }
  }
}
