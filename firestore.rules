rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Broadly allow all signed-in users to access meetings and sub-collections
    // This resolves permission issues with collection-level listing (dashboard)
    match /meetings/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    match /seriesAttendance/{allPaths=**} {
      allow read, write: if isSignedIn();
    }
  }
}