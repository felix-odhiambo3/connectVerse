
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Standardized rules for meetings and their sub-collections
    match /meetings/{meetingId} {
      allow read, write: if isSignedIn();
      
      // Recursive wildcard for chat, participants, and signaling
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /seriesAttendance/{seriesId}/users/{userId} {
      allow read, write: if isSignedIn();
    }
  }
}
