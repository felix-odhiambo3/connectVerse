
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /meetings/{meetingId} {
      // Allow any signed-in user to read and create meetings
      // This includes list operations for the dashboard
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource == null || resource.data.hostId == request.auth.uid);

      // Recursive match for all sub-collections (participants, chat, webrtc signaling)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /seriesAttendance/{seriesId}/users/{userId} {
      allow read, write: if isSignedIn();
    }
  }
}
