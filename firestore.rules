
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Explicitly handle collection and document levels for meetings
    match /meetings {
      allow list, create: if isSignedIn();
      
      match /{meetingId} {
        allow get, update, delete: if isSignedIn();
        
        // Match all subcollections (chat, participants, webrtc)
        match /{allSubcollections=**} {
          allow read, write: if isSignedIn();
        }
      }
    }

    match /seriesAttendance/{seriesId}/users/{userId} {
      allow read, write: if isSignedIn();
    }
  }
}
