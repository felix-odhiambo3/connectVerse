rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Robust match for meetings and all sub-resources (chat, signaling, etc)
    match /meetings/{meetingId} {
      allow read, write: if isSignedIn();
      
      // Sub-collections like chat, participants, and webrtc signaling
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Robust recursive match for series attendance
    match /seriesAttendance/{allPaths=**} {
      allow read, write: if isSignedIn();
    }
  }
}