
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /meetings/{meetingId} {
      // Allow any signed-in user to read, create, and update meetings
      // This includes list operations for the dashboard
      allow read, write: if isSignedIn();

      // Recursive match for all sub-collections (participants, chat, webrtc signaling)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /seriesAttendance/{seriesId}/users/{userId} {
      allow read, write: if isSignedIn();
    }
  }
}
