rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Explicitly allow list/get/write for meetings and all nested sub-collections
    // This resolves the permission error Elizabeth encountered on the dashboard
    match /meetings/{meetingId} {
      allow read, write: if isSignedIn();
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /seriesAttendance/{allPaths=**} {
      allow read, write: if isSignedIn();
    }
  }
}