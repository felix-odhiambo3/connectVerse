
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /meetings/{meetingId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
      
      match /chat/{chatMessageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
      }
      
      match /webrtc/{channel}/{docId=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /seriesAttendance/{seriesId}/users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Host needs to list to see reports
      allow write: if isSignedIn(); // Simplified for MVP updates from client
    }
  }
}
